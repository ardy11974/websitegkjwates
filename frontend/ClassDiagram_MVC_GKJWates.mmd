    class Roles {
        <<Model>>
        +id_role : Int
        +nama_role : String
        +deskripsi_role : String
    }
    class User {
        <<Model>>
        +id_user : Int
        +id_role : Int
        +username : String
        +email : String
        +password : String
        +created_at : DateTime
        +updated_at : DateTime
    }
    class Kategori {
